# =============================================
# OpenMPTCProuter - Minimal MPTCP-only profile
# Remove all bloated packages, keep only what's
# needed for basic MPTCP multi-WAN aggregation
# =============================================

# --- Disable the bloated full package ---
# CONFIG_PACKAGE_openmptcprouter-full is not set

# --- Core MPTCP ---
CONFIG_PACKAGE_mptcp=y
CONFIG_PACKAGE_luci-app-mptcp=y
CONFIG_PACKAGE_luci-app-openmptcprouter=y

# --- Essential networking ---
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_iptables-mod-nat-extra=m
CONFIG_PACKAGE_ethtool=y

# --- Firewall ---
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# --- Web UI base ---
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# --- SSH ---
CONFIG_PACKAGE_dropbear=y

# --- Usual tools (minimal) ---
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_ca-bundle=y

# --- 4G/5G modem support (keep ALL USB networking + modem drivers) ---
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=m
CONFIG_PACKAGE_kmod-usb-net-rtl8152=m
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_comgt-ncm=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-ncm=y
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-modemmanager=y

# --- Load balance / bonding ---
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_luci-proto-bonding=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-bridge=y
CONFIG_PACKAGE_kmod-ifb=y

# --- Network services ---
CONFIG_PACKAGE_sqm-scripts-extra=y
CONFIG_PACKAGE_luci-app-sqm-autorate=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_omr-quota=y
CONFIG_PACKAGE_luci-app-omr-quota=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-iperf=y
CONFIG_PACKAGE_luci-app-ttyd=y

# --- Network monitoring ---
CONFIG_PACKAGE_iperf3-ssl=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_tracebox=y
CONFIG_PACKAGE_iptraf-ng=y
CONFIG_PACKAGE_speedtestcpp=y

# --- File system / storage ---
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_f2fs-tools=y

# --- IPv6 ---
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_6to4=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_464xlat=y

# --- Network tools ---
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-tracepath=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_jq=y
